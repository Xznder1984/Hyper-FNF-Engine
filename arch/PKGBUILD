# Maintainer: Xznder1984 <xznder1984@users.noreply.github.com>
# Contributor: Xznder1984 <xznder1984@users.noreply.github.com>

# NOTE: this package targets the CLI (hfe). The Tauri desktop launcher is
# available from source (<repo>/crates/launcher) and requires the webkit2gtk-4.1
# stack plus the frontend in crates/launcher/frontend to build.

pkgname=hyper-fnf-engine
pkgver=0.1.0
pkgrel=1
pkgdesc="Run any Friday Night Funkin' mod on the exact engine it was built for (unofficial CLT: hfe)."
arch=('x86_64')
url="https://github.com/Xznder1984/Hyper-FNF-Engine"
license=('Apache-2.0')
depends=('gcc-libs')
makedepends=('cargo' 'rust')
conflicts=('hyper-fnf-engine-git')
provides=('hyper-fnf-engine')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Xznder1984/Hyper-FNF-Engine/archive/refs/tags/v$pkgver.tar.gz")
# REQUIRED before first release: replace this with the real sha256sum from
# `sha256sum` on the downloaded release tarball. Builds will refuse to proceed
# while it contains this placeholder.
sha256sums=('PLACEHOLDER_FILL_FROM_sha256sum_AT_FIRST_RELEASE')

build() {
    cd "$srcdir/Hyper-FNF-Engine-$pkgver"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --locked \
        --manifest-path crates/hfe-cli/Cargo.toml \
        --bin hfe
}

check() {
    cd "$srcdir/Hyper-FNF-Engine-$pkgver"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --release --manifest-path crates/hfe-cli/Cargo.toml
}

package() {
    cd "$srcdir/Hyper-FNF-Engine-$pkgver"
    export CARGO_TARGET_DIR="$srcdir/target"
    install -Dm755 "$CARGO_TARGET_DIR/release/hfe" "$pkgdir/usr/bin/hfe"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md" 2>/dev/null || true
}