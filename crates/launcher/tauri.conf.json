{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hyper Engine",
  "version": "0.1.0",
  "identifier": "dev.xznder1984.hyper-fnf-engine",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hyper Engine",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "FNF engine manager",
    "longDescription": "Detect, fetch and launch the exact Friday Night Funkin' engine your mod was built for.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}